# Secrets: never bake credentials into the image (compose mounts .env at runtime)
.env
.env.*
!.env.example

# VCS, caches, local environments
.git
.gitignore
**/__pycache__
**/*.py[cod]
.pytest_cache
.venv
venv
node_modules
.mcp

# Not needed at runtime
scratch
tests
Dockerfile
docker-compose*.yml
.vscode
.idea
